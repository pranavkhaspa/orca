# ---- Go ---------------------------------------------------------------------
# The binary and any local build output. The service has no third-party modules,
# so there is no vendor directory to keep and nothing to audit.
api/orca
api/api
*.test
*.out

# Local environment overrides. .env.example is committed; .env is not.
.env
.env.local
api/.env
web/.env
web/.env.local

# ---- Node / Vite ------------------------------------------------------------
node_modules/
web/dist/
web/.vite/
web/tsconfig.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ---- Editors and OS ---------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Local research clones, never committed -------------------------------
# Competitor repositories surveyed while comparing approaches. Roughly 190 MB,
# and one of them is a mirror of this project, so committing any of it would be
# both wasteful and confusing. Regenerate with the survey in INSTR.md.
.opencode/competitors/
