# ORCA API configuration.
#
# Every variable is optional. With none of them set the service starts, answers,
# and serves the deterministic planner and the ten-language templates. Copy to
# .env only if you want to override something.
#
# These are the only environment variables the service reads.

# ---- Model (optional) -------------------------------------------------------
# Without a key the system is fully functional; the model only ever affects the
# wording of an answer, never the safety verdict.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# PLAN_MODEL=deepseek/deepseek-v3.2
# NARRATE_MODEL=deepseek/deepseek-v3.2
# LLM_TIMEOUT_SEC=25

# ---- Server -----------------------------------------------------------------
# PORT=8080
# Comma-separated exact origins, or * to allow any. The default is * because the
# API is keyless and holds no credentials or cookies.
# ALLOWED_ORIGINS=*
# REQUEST_TIMEOUT_SEC=60

# ---- Upstream behaviour -----------------------------------------------------
# UPSTREAM_TIMEOUT_SEC=20
# MAX_CONCURRENT=6
# RATE_LIMIT_PER_MIN=12
# CACHE_TTL_SEC=900
# MARINE_DAYS=5

# ---- Geometry ---------------------------------------------------------------
# Distance of the default waypoint from the coast, and the radius of the
# fishing-zone search fan around it.
# WAYPOINT_KM=45
# PFZ_SEARCH_KM=120
# How far a resolved place may sit from the sea and still be asked about. Past
# this, ORCA asks where you mean instead of answering, because Hyderabad
# geocodes perfectly well and has no water in it.
# MAX_COAST_DISTANCE_KM=120

# ---- Reference data ---------------------------------------------------------
# Both default to the copies embedded in the binary, so no filesystem layout is
# required in deployment. Point them at files on disk to override.
# COASTAL_PATH=embed:coastal_towns.json
# SNAPSHOT_PATH=embed:snapshot.json

# ---- Demo switch ------------------------------------------------------------
# Suppresses every outbound call and answers from the baked snapshot, stamping
# each figure as non-live. Used to demonstrate resilience on stage and to make
# the guarantee testable in CI.
# ORCA_OFFLINE=1
